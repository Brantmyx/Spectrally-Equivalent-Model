!- EMS skeleton for thermochromic hourly SE construction switching.
!- EMS selects the hour-specific thermochromic construction only.
!- The thermochromic group itself selects the temperature state in EnergyPlus.
!- EMS skeleton for static hourly SE construction switching.
EnergyManagementSystem:Actuator,
    SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME,  !- Name
    REPLACE_WITH_WINDOW_SURFACE_NAME,                        !- Actuated Component Unique Name
    Surface,                          !- Actuated Component Type
    Construction State;               !- Actuated Component Control Type

EnergyManagementSystem:ProgramCallingManager,
    SE_Static_Window_Manager,         !- Name
    BeginTimestepBeforePredictor,     !- EnergyPlus Model Calling Point
    SE_Static_Window_Switcher;        !- Program Name

EnergyManagementSystem:Program,
    SE_Static_Window_Switcher,
    IF (Hour == 8)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h001
    ELSEIF (Hour == 9)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h002
    ELSEIF (Hour == 10)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h003
    ELSEIF (Hour == 11)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h004
    ELSEIF (Hour == 12)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h005
    ELSEIF (Hour == 13)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h006
    ELSEIF (Hour == 14)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h007
    ELSEIF (Hour == 15)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h008
    ELSEIF (Hour == 16)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h009
    ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_TC_Con_h001
    ENDIF;

