!- Static-window SE material and construction bank.

WindowMaterial:Glazing,
    SE_Static_Mat_h001,                         !- Name
    SpectralAverage,                !- Optical Data Type
    ,                               !- Window Glass Spectral Data Set Name
    0.006,        !- Thickness {m}
    0.786,        !- Solar Transmittance at Normal Incidence
    0.074435,    !- Front Side Solar Reflectance at Normal Incidence
    0.07358,     !- Back Side Solar Reflectance at Normal Incidence
    0.888461,      !- Visible Transmittance at Normal Incidence
    0.083263,  !- Front Side Visible Reflectance at Normal Incidence
    0.083288,   !- Back Side Visible Reflectance at Normal Incidence
    0,          !- Infrared Transmittance at Normal Incidence
    0.84,  !- Front Side Infrared Hemispherical Emissivity
    0.84,   !- Back Side Infrared Hemispherical Emissivity
    1,               !- Conductivity {W/m-K}
    1,          !- Dirt Correction Factor for Solar and Visible Transmittance
    No;                       !- Solar Diffusing


