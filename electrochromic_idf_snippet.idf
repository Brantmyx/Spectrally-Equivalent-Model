!- EMS skeleton for electrochromic hourly SE construction switching.
!- G_ctrl is an example site irradiance sensor. Users may replace it with
!- a surface-incident irradiance sensor for a specific window orientation.
EnergyManagementSystem:Sensor,
    G_ctrl, Environment, Site Direct Solar Radiation Rate per Area;

EnergyManagementSystem:Actuator,
    SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME,  !- Name
    REPLACE_WITH_WINDOW_SURFACE_NAME,                        !- Actuated Component Unique Name
    Surface,                          !- Actuated Component Type
    Construction State;               !- Actuated Component Control Type

EnergyManagementSystem:ProgramCallingManager,
    SE_EC_Window_Manager,
    BeginTimestepBeforePredictor,
    SE_EC_Window_Switcher;

EnergyManagementSystem:Program,
    SE_EC_Window_Switcher,
    IF (Hour == 8)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h001_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h001_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h001_S3
        ENDIF
    ELSEIF (Hour == 9)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h002_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h002_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h002_S3
        ENDIF
    ELSEIF (Hour == 10)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h003_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h003_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h003_S3
        ENDIF
    ELSEIF (Hour == 11)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h004_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h004_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h004_S3
        ENDIF
    ELSEIF (Hour == 12)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h005_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h005_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h005_S3
        ENDIF
    ELSEIF (Hour == 13)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h006_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h006_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h006_S3
        ENDIF
    ELSEIF (Hour == 14)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h007_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h007_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h007_S3
        ENDIF
    ELSEIF (Hour == 15)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h008_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h008_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h008_S3
        ENDIF
    ELSEIF (Hour == 16)
        IF (G_ctrl < 200)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h009_S1
        ELSEIF (G_ctrl < 400)
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h009_S2
        ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h009_S3
        ENDIF
    ELSE
        SET SE_Construction_Actuator_REPLACE_WITH_WINDOW_SURFACE_NAME = SE_EC_Con_h001_S1
    ENDIF;
